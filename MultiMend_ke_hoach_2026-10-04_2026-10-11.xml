  <Row ss:Height="32"><Cell ss:MergeAcross="8" ss:StyleID="Title"><Data ss:Type="String">Bảng quản lý thời gian 04/10/2026 - 11/10/2026</Data></Cell></Row>
  <Row><Cell ss:StyleID="Header"><Data ss:Type="String">Ngày</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Phiên</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Giai đoạn</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">GPU</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Tài khoản/lane</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Công việc</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Deliverable / gate</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Trạng thái</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Rủi ro / ghi chú</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">04/10</Data></Cell><Cell><Data ss:Type="String">00:00-12:00</Data></Cell><Cell><Data ss:Type="String">G0</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A01-A10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Backup checkpoint 581000, trainer_state, tokenizer/model; tạo SHA-256 manifest; kiểm tra đủ file.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Artifact training-resume và inference; global_step xác nhận 581000.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Đã chạy train; chờ xác minh</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Không xóa optimizer/scheduler/scaler/RNG nếu còn cần resume.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">04/10</Data></Cell><Cell><Data ss:Type="String">12:00-24:00</Data></Cell><Cell><Data ss:Type="String">G0</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A01-A10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Dựng baseline inference, chọn 5 checkpoint cuối theo trainer_state, kiểm tra official checkpoint nếu tải được.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Config hash, seed 42, input/output JSONL, smoke QuixBugs-Python.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Không suy luận checkpoint ensemble chỉ từ tên thư mục.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">05/10</Data></Cell><Cell><Data ss:Type="String">00:00-12:00</Data></Cell><Cell><Data ss:Type="String">G0/G1</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A01-A05</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Chạy B0 no-RAG và B1 fixed-RAG trên QuixBugs-Python.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Output đủ record, validator chạy, gate reproducible.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">QuixBugs nhỏ; dùng smoke test, không tune final trên test.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">05/10</Data></Cell><Cell><Data ss:Type="String">12:00-24:00</Data></Cell><Cell><Data ss:Type="String">G1</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A06-A10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Instrument retrieval distance/similarity, token trước/sau truncate, context bị mất; chạy subset Defects4J v1.2.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Case RAG giúp / không đổi / gây hại.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Log phải có context_strategy=fixed_rag.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">06/10</Data></Cell><Cell><Data ss:Type="String">00:00-12:00</Data></Cell><Cell><Data ss:Type="String">G2</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A01-A05</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Implement A1 token-budget-only và unit tests budget 512, empty, boundary, long context.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Không input vượt 512; fixed mode không regression.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Giữ local context trước retrieval.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">06/10</Data></Cell><Cell><Data ss:Type="String">12:00-24:00</Data></Cell><Cell><Data ss:Type="String">G2</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A06-A10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Implement A2 confidence gate, k=0..5; grid nhỏ tau {0.45,0.50,0.55,0.60}, lambda {0.6,0.8} khi cần.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">A2 có tín hiệu tốt hơn B1 hoặc giảm truncate rõ ràng.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Chốt rule trên development subset, không dùng test để tune.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">07/10</Data></Cell><Cell><Data ss:Type="String">00:00-12:00</Data></Cell><Cell><Data ss:Type="String">G3</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A01-A05</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Implement A3 MMR + lexical dedup + provenance metadata.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Metadata retrieved_count, token_count, similarity, margin, truncation.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Không phá schema validator.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">07/10</Data></Cell><Cell><Data ss:Type="String">12:00-24:00</Data></Cell><Cell><Data ss:Type="String">G3</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A06-A10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Implement A4 dual-view budget-matched; A5 full budget chỉ khi còn ngân sách.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">50 no-RAG + 50 adaptive-RAG nếu baseline là 100 candidate/checkpoint.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Báo riêng effectiveness và compute cost.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">08/10</Data></Cell><Cell><Data ss:Type="String">00:00-12:00</Data></Cell><Cell><Data ss:Type="String">G3</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A01-A10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Chạy B0, B1, A1-A4 đủ trên Defects4J v1.2; so sánh correct/top-k/truncate.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Freeze tau, lambda, k_max và policy beam.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Nếu A2 không thắng B1, dừng mở rộng và phân tích log.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">08/10</Data></Cell><Cell><Data ss:Type="String">12:00-24:00</Data></Cell><Cell><Data ss:Type="String">G4</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A01-A10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Freeze config; chuẩn bị shard và manifest cho evaluation.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Không đổi code/config sau mốc freeze; mỗi shard có checksum.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Tách output path theo benchmark/strategy/checkpoint/shard.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">09/10</Data></Cell><Cell><Data ss:Type="String">00:00-12:00</Data></Cell><Cell><Data ss:Type="String">G4</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A01-A05</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Evaluation QuixBugs Java/Python và BugAID: B0, B1, A4.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Cross-language smoke kết thúc, có manifest complete.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">QuixBugs-Python ưu tiên smoke, không overclaim.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">09/10</Data></Cell><Cell><Data ss:Type="String">12:00-24:00</Data></Cell><Cell><Data ss:Type="String">G4</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A06-A10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Evaluation RunBugRun-JS; validation theo bug shard.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">JSONL, metrics và checksum đầy đủ.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Test time lệch; shard theo bug.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">10/10</Data></Cell><Cell><Data ss:Type="String">00:00-12:00</Data></Cell><Cell><Data ss:Type="String">G4</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A01-A05</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Evaluation Defects4J v2.0 và BugsInPy; B0, B1, A4.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Per-benchmark metrics và cost.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">BugsInPy phụ thuộc nhiều Python runtime.</Data></Cell></Row>
  <Row><Cell><Data ss:Type="String">10/10</Data></Cell><Cell><Data ss:Type="String">12:00-24:00</Data></Cell><Cell><Data ss:Type="String">G4</Data></Cell><Cell><Data ss:Type="Number">30</Data></Cell><Cell><Data ss:Type="String">A06-A10</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Evaluation Codeflaws; chỉ chạy A5 nếu còn ngân sách.</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Manifest theo shard, không trùng output path.</Data></Cell><Cell ss:StyleID="Tbd"><Data ss:Type="String">Chưa chạy</Data></Cell><Cell ss:StyleID="Wrap"><Data ss:Type="String">Quy mô lớn, ưu tiên cuối đúng roadmap.</Data></Cell></Row>
